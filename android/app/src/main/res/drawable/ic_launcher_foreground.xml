<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标前景：三条字幕行 + 一个麦克风点，全部矢量，无位图 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 第一行字幕（最长） -->
    <path
        android:pathData="M32,42 L76,42"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- 第二行字幕（中等） -->
    <path
        android:pathData="M32,54 L66,54"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- 第三行字幕（短，配一个高亮点表示正在识别） -->
    <path
        android:pathData="M32,66 L56,66"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <path
        android:pathData="M68,61.5 a4.5,4.5 0 1,0 0.1,0 z"
        android:fillColor="#8FE3C0" />

</vector>
